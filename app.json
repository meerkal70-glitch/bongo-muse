{
  "expo": {
    "name": "Bongo Stream",
    "slug": "combongostreamapp",
    "backgroundColor": "#0A0A0F",
    "version": "1.0.4",
    "scheme": "bongo-stream",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bongostream.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Bongo Stream uses the microphone to record your vocals and voice samples.",
        "NSCameraUsageDescription": "Bongo Stream uses the camera to scan lyrics and take cover photos.",
        "NSPhotoLibraryUsageDescription": "Bongo Stream needs access to your photos to set cover art and profile pictures.",
        "NSPhotoLibraryAddUsageDescription": "Bongo Stream saves share cards and cover art to your photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#0A0A0F",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.bongostream.app",
      "versionCode": 6,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Bongo Stream uses the microphone to record your vocals and voice samples."
        }
      ],
      "expo-asset",
      "./withRemoveMediaPermissions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72872d7d-624b-4d08-8ede-ef50e9c04bb8"
      }
    },
    "owner": "cmdss"
  }
}
