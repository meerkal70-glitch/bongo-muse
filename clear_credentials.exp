#!/usr/bin/expect -f
set timeout -1

spawn bash -c "export NVM_DIR=\"$HOME/.nvm\" && \[ -s \"$NVM_DIR/nvm.sh\" \] && \\. \"$NVM_DIR/nvm.sh\" && export EXPO_TOKEN=\"IO7xn3M7yFR_3nSCCmIprTNYeapZmuf3fExUMaMv\" && eas credentials -p android"

expect "Select Android build profile:"
send "\r"

# It might ask to select a build profile, let's just hit enter for default (production)

expect "What do you want to do?"
# We want to press down arrow to select "Remove a Keystore"
# Wait, "Remove a Keystore" might be the 4th option.
# Keystore: Manage everything
# Let's send DOWN arrow twice or type "Remove a Keystore" if it supports search.
# eas-cli prompts support typing to filter!
send "Remove a Keystore\r"

expect {
  "Are you sure?" {
    send "Y\r"
    exp_continue
  }
  "Select a keystore to remove" {
    send "\r"
    exp_continue
  }
  "What do you want to do?" {
    send "Remove a Keystore\r"
    exp_continue
  }
  eof
}
